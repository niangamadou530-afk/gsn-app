# Supabase configuration (obtenir depuis votre tableau de bord Supabase)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# IA / Groq (obtenir depuis console.groq.com)
GROQ_API_KEY=your-groq-api-key-here

# YouTube Data API v3 (Optionnel, Google Cloud Console)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Administration sécurisée côté serveur (Vercel)
ADMIN_EMAIL=votre-email-administrateur@domaine.com

# Paramètres IA optionnels (valeurs par défaut appliquées automatiquement si non définies)
# PREP_TIME_BUDGET_MS=45000
# PREP_DOC_MAX_CHARS=6000
